# --- Required ---
# PostgreSQL connection string. Supabase: use the "Connection pooling" (transaction, port 6543) URL on Vercel
# and append ?sslmode=require  e.g. postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.asbaxmisbcwjykwndayj:sachin0123jhajee@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# --- Optional ---
# Public site URL used for Open Graph metadata (e.g. https://kaamproof.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Max DB connections per server instance (default 5; keep small on serverless)
DB_POOL_MAX=5
# Demo seeding (development only; refused when NODE_ENV=production)
# ALLOW_DEMO_SEED=true

# Shared rate limiting (REQUIRED for multi-instance/Vercel; free tier at upstash.com). Falls back to in-memory if unset.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Password-reset emails via Resend (https://resend.com). If unset, reset links are printed to the server console in development only.
# RESEND_API_KEY=
# MAIL_FROM="KaamProof <no-reply@yourdomain.com>"
