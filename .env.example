# --- Required ---
# PostgreSQL connection string.
# Supabase: use the "Connection pooling" (transaction mode, port 6543) URL.
# Append ?pgbouncer=true for Supabase PgBouncer pooler.
# For Vercel/serverless, also append &sslmode=require if needed.
# Example format (replace with your actual credentials):
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:6543/postgres?pgbouncer=true
SESSION_SECRET=replace-with-a-long-random-server-only-secret
NODE_ENV=development
APP_ENV=development
DATABASE_TARGET=development
ALLOW_DEMO_SEED=false

# --- Optional ---
# Public site URL used for Open Graph metadata (e.g. https://kaamproof.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Max DB connections per server instance (default 5; keep small on serverless)
DB_POOL_MAX=5
# Demo seeding (development only; refused when NODE_ENV=production)
# ALLOW_DEMO_SEED=true
# APP_ENV=development
# DATABASE_TARGET=development
# DEMO_WORKER_PHONE=9000000001
# DEMO_EMPLOYER_PHONE=9111111111
# DEMO_PASSWORD=choose-a-local-only-password

# Shared rate limiting (REQUIRED for multi-instance/Vercel; free tier at upstash.com). Falls back to in-memory if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
